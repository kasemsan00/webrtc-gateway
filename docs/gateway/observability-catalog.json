{
  "schemaVersion": 1,
  "resourceFields": [
    "service.name",
    "service.version",
    "deployment.environment",
    "service.instance.id"
  ],
  "recordFields": [
    "timestamp",
    "severity",
    "component",
    "event.name",
    "outcome",
    "reason",
    "session.id",
    "call.correlation_id",
    "trunk.id",
    "duration_ms",
    "count",
    "bytes"
  ],
  "components": [
    "gateway",
    "http",
    "websocket",
    "call",
    "sip",
    "webrtc",
    "media",
    "persistence",
    "push",
    "translator",
    "telemetry"
  ],
  "eventNames": [
    "gateway.started",
    "gateway.stopping",
    "gateway.stopped",
    "http.request.completed",
    "websocket.connected",
    "websocket.disconnected",
    "websocket.message.completed",
    "websocket.message.dropped",
    "call.started",
    "call.setup.completed",
    "call.completed",
    "call.resume.completed",
    "sip.transaction.completed",
    "persistence.batch.completed",
    "persistence.record.dropped",
    "push.request.completed",
    "translator.request.completed",
    "media.health.sampled",
    "media.recovery.requested",
    "telemetry.export.completed",
    "telemetry.export.failed",
    "telemetry.record.dropped"
  ],
  "outcomes": [
    "success",
    "failure",
    "rejected",
    "timeout",
    "cancelled",
    "dropped",
    "disabled",
    "unknown"
  ],
  "reasons": [
    "none",
    "invalid_request",
    "unauthorized",
    "forbidden",
    "not_found",
    "conflict",
    "peer_closed",
    "remote_rejected",
    "deadline_exceeded",
    "dependency_unavailable",
    "queue_full",
    "export_failed",
    "shutdown_deadline",
    "internal_error",
    "unknown"
  ],
  "metricAttributes": {
    "allowed": [
      "component",
      "direction",
      "outcome",
      "reason",
      "sip.method",
      "sip.status_class",
      "websocket.message_type",
      "dependency.name",
      "media.kind",
      "recovery.type"
    ],
    "forbiddenNameFragments": [
      "session",
      "call_id",
      "phone",
      "number",
      "username",
      "user_id",
      "ip",
      "address",
      "device",
      "token",
      "url",
      "error.message",
      "payload",
      "body"
    ]
  },
  "metrics": [
    { "name": "gateway.process.starts", "kind": "counter", "unit": "{start}", "attributes": [] },
    { "name": "gateway.process.uptime", "kind": "gauge", "unit": "s", "attributes": [] },
    { "name": "gateway.telemetry.records", "kind": "counter", "unit": "{record}", "attributes": ["outcome", "reason"] },
    { "name": "gateway.telemetry.queue.utilization", "kind": "gauge", "unit": "1", "attributes": [] },
    { "name": "gateway.calls.active", "kind": "updown_counter", "unit": "{call}", "attributes": ["direction"] },
    { "name": "gateway.calls.started", "kind": "counter", "unit": "{call}", "attributes": ["direction"] },
    { "name": "gateway.calls.completed", "kind": "counter", "unit": "{call}", "attributes": ["direction", "outcome", "reason"] },
    { "name": "gateway.calls.setup.duration", "kind": "histogram", "unit": "s", "attributes": ["direction", "outcome"] },
    { "name": "gateway.calls.duration", "kind": "histogram", "unit": "s", "attributes": ["direction", "outcome"] },
    { "name": "gateway.websocket.connections.active", "kind": "updown_counter", "unit": "{connection}", "attributes": [] },
    { "name": "gateway.websocket.messages", "kind": "counter", "unit": "{message}", "attributes": ["websocket.message_type", "outcome"] },
    { "name": "gateway.sip.transactions", "kind": "counter", "unit": "{transaction}", "attributes": ["sip.method", "sip.status_class", "outcome"] },
    { "name": "gateway.sip.transaction.duration", "kind": "histogram", "unit": "s", "attributes": ["sip.method", "sip.status_class", "outcome"] },
    { "name": "gateway.persistence.queue.utilization", "kind": "gauge", "unit": "1", "attributes": ["component"] },
    { "name": "gateway.persistence.records.dropped", "kind": "counter", "unit": "{record}", "attributes": ["component", "reason"] },
    { "name": "gateway.persistence.batch.duration", "kind": "histogram", "unit": "s", "attributes": ["component", "outcome"] },
    { "name": "gateway.dependency.requests", "kind": "counter", "unit": "{request}", "attributes": ["dependency.name", "outcome", "reason"] },
    { "name": "gateway.dependency.request.duration", "kind": "histogram", "unit": "s", "attributes": ["dependency.name", "outcome"] },
    { "name": "gateway.media.packet_loss", "kind": "histogram", "unit": "1", "attributes": ["direction", "media.kind"] },
    { "name": "gateway.media.jitter", "kind": "histogram", "unit": "s", "attributes": ["direction", "media.kind"] },
    { "name": "gateway.media.rtt", "kind": "histogram", "unit": "s", "attributes": ["direction", "media.kind"] },
    { "name": "gateway.media.recovery.requests", "kind": "counter", "unit": "{request}", "attributes": ["direction", "recovery.type", "outcome"] }
  ],
  "spanAttributes": [
    "component",
    "session.id",
    "call.correlation_id",
    "trunk.id",
    "call.direction",
    "outcome",
    "reason",
    "http.request.method",
    "http.route",
    "http.response.status_code",
    "websocket.message_type",
    "sip.method",
    "sip.status_code",
    "dependency.name"
  ],
  "forbiddenCentralFields": [
    "authorization",
    "proxy-authorization",
    "password",
    "credential",
    "access_token",
    "refresh_token",
    "private_key",
    "db.dsn",
    "turn.credential",
    "push.token",
    "message.body",
    "transcript.body",
    "sip.raw",
    "sdp.raw",
    "payload.raw"
  ]
}
