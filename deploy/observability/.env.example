# Existing OpenObserve OTLP base endpoint, including the organization path.
# Example: https://observe.example.com/api/acme
OPENOBSERVE_OTLP_ENDPOINT=https://observe.example.invalid/api/example-org
OPENOBSERVE_ORGANIZATION=example-org
OPENOBSERVE_LOG_STREAM=gateway-logs-dev
OPENOBSERVE_METRIC_STREAM=gateway-metrics-dev
OPENOBSERVE_TRACE_STREAM=gateway-traces-dev

# Inject at runtime from a secret store. Do not commit a real Basic/Bearer value.
OPENOBSERVE_AUTHORIZATION=Basic_REPLACE_FROM_SECRET_STORE

# false verifies the OpenObserve server certificate. Use true only for a local
# disposable test endpoint, never as a production shortcut.
OPENOBSERVE_TLS_INSECURE=false
OPENOBSERVE_TLS_CA_FILE=

GATEWAY_ENVIRONMENT=development
GATEWAY_LOG_FILE=/var/log/webrtc-sip-gateway/webrtc-sip-gateway-*.log
OTELCOL_FILE_STORAGE_DIRECTORY=/var/lib/otelcol/file-storage

# Gateway-side endpoint. It contains no OpenObserve credentials.
OTEL_ENABLE=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=webrtc-sip-gateway
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
OTEL_TRACES_ENABLE=true
OTEL_TRACES_SAMPLER_ARG=0.05
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY_MS=5000
OTEL_EXPORTER_OTLP_TIMEOUT_MS=3000
OTEL_SHUTDOWN_TIMEOUT_MS=5000
