worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Behind TLS terminator (NPM, host nginx): honor client-facing scheme/host.
    map $http_x_forwarded_proto $forwarded_scheme {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    map $http_x_forwarded_host $forwarded_host {
        default $http_x_forwarded_host;
        ''      $host;
    }

    upstream gateway {
        server 127.0.0.1:${GATEWAY_PORT};
    }

    upstream frontend {
        server 127.0.0.1:${FRONTEND_PORT};
    }

    server {
        listen ${PROXY_PORT};
        server_name _;
        absolute_redirect off;
        port_in_redirect off;

        # Public entry: use forwarded scheme/host so clients never see :8088.
        location = / {
            return 302 $forwarded_scheme://$forwarded_host/admin/;
        }

        location /admin/ {
            proxy_pass http://frontend;
            proxy_http_version 1.1;
            proxy_set_header Host $forwarded_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_set_header X-Forwarded-Host $forwarded_host;
        }

        # Gateway REST API
        location /api/ {
            proxy_pass http://gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $forwarded_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_set_header X-Forwarded-Host $forwarded_host;
        }

        # Authenticated WebSocket signaling
        location /ws {
            proxy_pass http://gateway;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $forwarded_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Public WebSocket (optional; enabled via API_ENABLE_PUBLIC_WS)
        location /ws-public {
            proxy_pass http://gateway;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $forwarded_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_scheme;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
