# TURN Server Configuration (for WebRTC)
TURN_SERVER=turn:turn.ttrs.or.th:3478?transport=udp
TURN_USERNAME=turn01
TURN_PASSWORD=Test1234

# Local IP to bind SIP listeners (Optional - prevents IPv6 Via headers)
# Use specific IPv4 address (e.g., 192.168.1.100, 100.100.1.100) to force IPv4
# Default: 0.0.0.0 (all interfaces, but may use IPv6 on Windows)
# Find your local IP: ipconfig (Windows) or ifconfig/ip addr (Linux)
SIP_LOCAL_IP=0.0.0.0

# SIP listener transports
# TCP listener is enabled by default and is required for providers/proxies using TCP/TLS upstream handoff
# UDP listener is disabled by default; enable when your provider/client sends INVITE to gateway over UDP
SIP_LISTEN_TCP=true
SIP_LISTEN_UDP=false

# Public IP (Optional - for NAT traversal)
# If gateway is behind NAT, set this to your public IP address
# Asterisk will use this IP to send SIP/RTP packets back to gateway
# Leave empty to use local IP address (auto-detected)
SIP_PUBLIC_IP=49.49.54.94

# API Server Configuration (for HTTP/WebSocket signaling)
# Port for the HTTP/WebSocket API server
API_PORT=8080
# Enable WebSocket endpoint (/ws) for real-time signaling
API_ENABLE_WS=true
# Enable REST API endpoints (/api/*)
API_ENABLE_REST=true
# CORS allowed origins (comma-separated, use * for all)
# Single-domain deploy example: https://k2-gateway.kasemsan.com
API_CORS_ORIGINS=*

# JWT/Auth Configuration (Keycloak JWKS)
# When AUTH_ENABLE=true:
# - /api/* requires Authorization: Bearer <token>
# - /ws requires ?access_token=<token>
# - Optional realm hint:
#   - REST: X-Auth-Type: user|employee|agent
#   - WS: ?auth_type=user|employee|agent
# - If no hint is provided, gateway uses hybrid verification (try configured realms in order).
AUTH_ENABLE=false
AUTH_JWKS_TIMEOUT_MS=5000

# User/client realm (softphone tokens)
AUTH_TTRS_USERS_JWKS_URL=https://accounts.ttrs.or.th/auth/realms/TTRS-Users/protocol/openid-connect/certs
AUTH_TTRS_USERS_JWT_ISSUER=
AUTH_TTRS_USERS_JWT_AUDIENCE=

# Employee/agent realm (agent tokens for API/WS auth verification)
AUTH_TTRS_EMPLOYEE_JWKS_URL=https://accounts.ttrs.or.th/auth/realms/TTRS-Users/protocol/openid-connect/certs
AUTH_TTRS_EMPLOYEE_JWT_ISSUER=
AUTH_TTRS_EMPLOYEE_JWT_AUDIENCE=

# Mobile SIP credential provisioning.
# When set, authenticated user-realm WebSocket clients are provisioned through
# this endpoint before /ws upgrade completes. The gateway posts form-data:
# token=<access_token>, type=mobile. Provisioning requires DB + SIP_TRUNK_ENABLE.
SIPCLIENT_AUTH_REGISTER_URL=https://sipclient-auth.ttrs.or.th/auth/register
SIPCLIENT_AUTH_TIMEOUT_MS=5000

# Debug Configuration
# Enable WebSocket debug logging (ping/pong messages, connection events)
# Set to true to see heartbeat logs for troubleshooting connection issues
DEBUG_WEBSOCKET=false

# Enable TURN/ICE debug logging (ICE candidates, selected candidate pair)
# Set to true to see detailed ICE candidate discovery and selected path information
# Useful for verifying that WebRTC connections are using TURN relay servers
# Logs include: candidate types (host/srflx/relay), addresses, ports, and selected pair details
DEBUG_TURN=false

# Enable SIP MESSAGE debug logging (show full MESSAGE request/response details)
# Set to true to see complete SIP MESSAGE headers and body for troubleshooting
DEBUG_SIP_MESSAGE=false

# Enable SIP INVITE debug logging (show full INVITE headers)
# Set to true to dump full INVITE requests (useful for Record-Route debugging)
DEBUG_SIP_INVITE=false

# Delay in milliseconds before sending PLI on @switch message (default: 0)
# When receiving @switch:queueNumber|agentUsername message, this delay is applied
# after immediate FIR+PLI kick and before the burst loops.
# Set to 0 (recommended) for fastest escalation.
SWITCH_PLI_DELAY_MS=0

# @switch video transition hold (SIP -> WebRTC)
# preserve: keep the last rendered remote frame visible while holding unsafe
# non-keyframe video until first keyframe or max wait timeout.
# blackout: legacy rollback mode that intentionally blacks remote video briefly.
SIP_SWITCH_VIDEO_TRANSITION_MODE=preserve
SIP_SWITCH_VIDEO_BLACKOUT_ENABLED=true
SIP_SWITCH_VIDEO_BLACKOUT_MS=300
SIP_SWITCH_VIDEO_BLACKOUT_MAX_WAIT_MS=1200

# RTP Configuration (for media streams)
# UDP port range for RTP audio/video streams
# Default: 10500-10600 (supports ~25 concurrent video calls, ~100 audio-only calls)
RTP_PORT_MIN=10500
RTP_PORT_MAX=10600
# RTP packet buffer size in bytes (default: 16384 for Android mobile compatibility)
# Android WebRTC can send packets at higher rates. Increase if you experience blackscreen on Android
RTP_BUFFER_SIZE=16384

# Use RTP/AVPF profile for audio with RTCP feedback (default: false)
# When enabled, SDP audio m-line will use RTP/AVPF instead of RTP/AVP
# This enables RTCP feedback mechanisms for audio stream
# Requires SIP endpoint (Asterisk/Linphone) to support AVPF for audio
# For Asterisk chan_sip: may require avpf=yes in peer config (depending on version)
# Set to true if your SIP server supports AVPF for better audio quality/recovery
SIP_AUDIO_USE_AVPF=true

# Inbound audio gain (SIP → WebRTC): decode Opus, apply PCM gain, re-encode Opus
# Requires Docker build with CGO + libopus (see Dockerfile)
# SIP_AUDIO_INBOUND_GAIN_ENABLE=false
# SIP_AUDIO_INBOUND_GAIN=1.5
# SIP_AUDIO_INBOUND_GAIN_MAX=3.0

# Use RTP/AVPF profile for video with RTCP feedback (PLI/FIR/NACK) (default: false)
# When enabled, SDP video m-line will use RTP/AVPF instead of RTP/AVP and include a=rtcp-fb attributes
# This enables Picture Loss Indication (PLI), Full Intra Request (FIR), and Negative Acknowledgments (NACK)
# Requires SIP endpoint (Asterisk/Linphone) to support AVPF and RTCP feedback
# Set to true if your SIP server and clients support AVPF for better keyframe recovery
SIP_VIDEO_USE_AVPF=true

# SIP-side transport target for outbound video feedback packets (PLI/FIR/NACK)
# Values: auto | rtp | rtcp | dual
# - auto: legacy learned-RTCP + fallback-window behavior
# - rtp:  always send feedback to SIP video RTP port (recommended for chan_sip rtcp-mux style)
# - rtcp: always send feedback to learned/rtp+1 RTCP target only
# - dual: always send both RTP and RTCP targets (RTP first)
SIP_VIDEO_FEEDBACK_TRANSPORT=auto

# Assemble SIP H.264 RTP into complete access units before WebRTC forwarding.
# Keeps outbound sequence/timestamps continuous and drops incomplete FU-A frames.
# Set false only as a temporary rollback to the legacy raw reordered path.
SIP_VIDEO_AU_NORMALIZE_ENABLE=true

# Database (required for trunk resolve/create)
DB_ENABLE=true
# Example Postgres DSN: postgres://user:pass@host:5432/dbname?sslmode=disable
DB_DSN=postgres://user:pass@localhost:5432/k2gateway?sslmode=disable

# SIP Trunk (auto-register from DB)
SIP_TRUNK_ENABLE=true
SIP_TRUNK_LEASE_TTL_SECONDS=60
SIP_TRUNK_LEASE_RENEW_INTERVAL_SECONDS=20
SIP_TRUNK_REGISTER_TIMEOUT_SECONDS=10

# Gateway identity / discovery
GATEWAY_INSTANCE_ID=dev-instance-1
# Public WS URL for redirect (e.g. wss://k2-gateway.kasemsan.com/ws)
GATEWAY_PUBLIC_WS_URL=

# Push Notification (FCM fallback via TTRS + APNs PushKit for iOS VoIP)
# When PUSH_ENABLE=true, gateway sends configured push channels on incoming trunk calls.
# FCM requires TTRS Notification API credentials and Firebase service account.
# APNs uses the iOS PushKit token persisted in sip_trunks.pn_token.
PUSH_ENABLE=false
# SIP Contact app-id accepted for trunk PushKit tokens.
PUSH_TRUNK_PN_APP_ID=th.or.ttrs.video.prod
# TTRS Notification API base URL
PUSH_TTRS_API_URL=https://api.ttrs.or.th
# HTTP timeout for TTRS API calls (milliseconds)
PUSH_TTRS_API_TIMEOUT_MS=5000

# Employee credentials used for /employees/v3/accounts/:id/notifications
AUTH_TTRS_EMPLOYEE_TOKEN_URL=https://accounts.ttrs.or.th/auth/realms/TTRS-Employees/protocol/openid-connect/token
AUTH_TTRS_EMPLOYEE_TOKEN_GRANT_TYPE=client_credentials
AUTH_TTRS_EMPLOYEE_CLIENT_ID=TTRS_Develop
AUTH_TTRS_EMPLOYEE_CLIENT_SECRET=k8x9hyhSOFRYnXTxH8lvvsVM5YuSjOTl

PUSH_FIREBASE_CREDENTIALS_FILE=
PUSH_FIREBASE_PROJECT_ID=643558767688

# APNs VoIP / PushKit
PUSH_APNS_ENABLE=false
# sandbox or production
PUSH_APNS_ENV=production
# token (default, .p8 key) or certificate (PEM client certificate)
PUSH_APNS_AUTH_MODE=token

# Token auth (.p8)
PUSH_APNS_KEY_FILE=
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=

# Certificate auth (PEM). Cert/key may be separate files, or one combined PEM.
# When PUSH_APNS_CERT_KEY_FILE is empty, gateway uses PUSH_APNS_CERT_FILE for both cert and key.
PUSH_APNS_CERT_FILE=
PUSH_APNS_CERT_KEY_FILE=

PUSH_APNS_BUNDLE_ID=th.or.nectec.kasemsan.softphone
# Defaults to <PUSH_APNS_BUNDLE_ID>.voip when empty
# For certificate auth, set this explicitly to a topic contained in the certificate,
# for example th.or.nectec.kasemsan.softphone.voip.
PUSH_APNS_TOPIC=
