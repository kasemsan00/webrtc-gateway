# TURN Server Configuration (for WebRTC)
TURN_SERVER=turn:turn.ttrs.or.th:3478?transport=udp
TURN_USERNAME=replace_with_turn_username
TURN_PASSWORD=replace_from_secret_store

# Local IP to bind SIP listeners (Optional - prevents IPv6 Via headers)
# Use specific IPv4 address (e.g., 192.168.1.100, 100.100.1.100) to force IPv4
# Default: 0.0.0.0 (all interfaces, but may use IPv6 on Windows)
# Find your local IP: ipconfig (Windows) or ifconfig/ip addr (Linux)
SIP_LOCAL_IP=0.0.0.0
# SIP signaling ports (both default to 5060)
SIP_PORT=5060
SIP_LOCAL_PORT=5060

# SIP listener transports
# TCP listener is enabled by default and is required for providers/proxies using TCP/TLS upstream handoff
# UDP listener is disabled by default; enable when your provider/client sends INVITE to gateway over UDP
SIP_LISTEN_TCP=true
SIP_LISTEN_UDP=false

# Public IP (Optional - for NAT traversal)
# If gateway is behind NAT, set this to your public IP address
# Asterisk will use this IP to send SIP/RTP packets back to gateway
# Leave empty to use local IP address (auto-detected)
SIP_PUBLIC_IP=49.49.54.94

# API Server Configuration (for HTTP/WebSocket signaling)
# Port for the HTTP/WebSocket API server
API_PORT=8080
# Enable WebSocket endpoint (/ws) for real-time signaling
API_ENABLE_WS=true
# Enable unauthenticated public SIP WebSocket (/ws-public) for per-call credentials only
API_ENABLE_PUBLIC_WS=false
# Enable unauthenticated PC agent WebSocket (/ws-agent) for credential-based REGISTER presence
API_ENABLE_AGENT_WS=false
# Enable REST API endpoints (/api/*)
API_ENABLE_REST=true
# CORS allowed origins (comma-separated, use * for all)
# Single-domain deploy example: https://gateway.example.com
API_CORS_ORIGINS=*

# Incoming trunk calls ring for this many seconds before gateway returns 480.
SIP_INCOMING_RING_TIMEOUT_SECONDS=30
# Current supported policy: try push delivery, then return 480 when unavailable.
SIP_INCOMING_OFFLINE_POLICY=push_then_480

# OpenTelemetry (optional; exports only to an OpenTelemetry Collector)
# Keep disabled until a Collector is deployed and validated. The gateway never
# needs the OpenObserve endpoint, organization, stream, or authorization secret.
OTEL_ENABLE=false
# OTLP/HTTP default. For Docker, use e.g. http://otel-collector:4318.
# For OTEL_EXPORTER_OTLP_PROTOCOL=grpc, normally use http://otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Optional Collector-only headers. Values are secret and are redacted from the
# safe config view. Do not put OpenObserve ingestion credentials in the gateway.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=webrtc-sip-gateway
OTEL_DEPLOYMENT_ENVIRONMENT=unspecified
# Optional comma-separated OTel resource attributes. Keep values non-sensitive;
# service.instance.id is derived from GATEWAY_INSTANCE_ID by the gateway.
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
OTEL_TRACES_ENABLE=true
# Parent-based ratio sampler argument in [0,1]. Start conservatively.
OTEL_TRACES_SAMPLER_ARG=0.05
# All batching/export/shutdown limits are finite. Saturation drops telemetry; it
# must never block SIP/WebSocket/media processing.
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY_MS=5000
OTEL_EXPORTER_OTLP_TIMEOUT_MS=3000
OTEL_SHUTDOWN_TIMEOUT_MS=5000

# JWT/Auth Configuration (Keycloak JWKS for mobile /ws and JWT REST clients)
# When AUTH_ENABLE=true:
# - Protected /api/* routes require Authorization: Bearer <jwt> OR FRONTEND_PASSWORD
# - GET /api/client-diagnostics* query routes remain public
# - /ws requires ?access_token=<jwt> (admin password is not accepted)
# - Optional realm hint:
#   - REST: X-Auth-Type: user|employee|agent
#   - WS: ?auth_type=user|employee|agent
# - If no hint is provided, gateway uses hybrid verification (try configured realms in order).
AUTH_ENABLE=false
AUTH_JWKS_TIMEOUT_MS=5000

# Shared admin password for the frontend login and authenticated REST.
# Set the same value in the frontend process. Leave empty only for gateway-only deploys.
FRONTEND_PASSWORD=

# User/client realm (softphone tokens)
AUTH_TTRS_USERS_JWKS_URL=https://accounts.ttrs.or.th/auth/realms/TTRS-Users/protocol/openid-connect/certs
AUTH_TTRS_USERS_JWT_ISSUER=
AUTH_TTRS_USERS_JWT_AUDIENCE=

# Employee/agent realm (agent tokens for API/WS auth verification)
AUTH_TTRS_EMPLOYEE_JWKS_URL=https://accounts.ttrs.or.th/auth/realms/TTRS-Employees/protocol/openid-connect/certs
AUTH_TTRS_EMPLOYEE_JWT_ISSUER=
AUTH_TTRS_EMPLOYEE_JWT_AUDIENCE=

# Mobile SIP credential provisioning.
# When set, authenticated user-realm WebSocket clients are provisioned through
# this endpoint before /ws upgrade completes. The gateway posts form-data:
# token=<access_token>, type=mobile. Provisioning requires DB + SIP_TRUNK_ENABLE.
SIPCLIENT_AUTH_REGISTER_URL=https://sipclient-auth.ttrs.or.th/auth/register
SIPCLIENT_AUTH_TIMEOUT_MS=5000

# Debug Configuration
# Enable WebSocket debug logging (ping/pong messages, connection events)
# Set to true to see heartbeat logs for troubleshooting connection issues
DEBUG_WEBSOCKET=false

# Enable TURN/ICE debug logging (ICE candidates, selected candidate pair)
# Set to true to see detailed ICE candidate discovery and selected path information
# Useful for verifying that WebRTC connections are using TURN relay servers
# Logs include: candidate types (host/srflx/relay), addresses, ports, and selected pair details
DEBUG_TURN=false

# Enable SIP MESSAGE debug logging (show full MESSAGE request/response details)
# Set to true to see complete SIP MESSAGE headers and body for troubleshooting
DEBUG_SIP_MESSAGE=false

# Enable SIP INVITE debug logging (show full INVITE headers)
# Set to true to dump full INVITE requests (useful for Record-Route debugging)
DEBUG_SIP_INVITE=false

# Persisting raw SIP requests/responses can expose Authorization and bodies.
# Keep false in production; PostgreSQL LogStore remains authoritative without it.
DB_LOG_FULL_SIP=false

# Delay in milliseconds before sending PLI on @switch message (default: 0)
# When receiving @switch:queueNumber|agentUsername message, this delay is applied
# after immediate FIR+PLI kick and before the burst loops.
# Set to 0 (recommended) for fastest escalation. Delayed bursts abort if a
# complete IDR already arrived, so a non-zero delay will not storm recovered calls.
SWITCH_PLI_DELAY_MS=0

# Keyframe watchdog (SIP → WebRTC). Stale must sit above a healthy SIP GOP
# (~3s on current Asterisk) or the watchdog will request IDRs forever.
SIP_VIDEO_KEYFRAME_WATCHDOG=true
SIP_VIDEO_KEYFRAME_WATCHDOG_INTERVAL_MS=2000
SIP_VIDEO_KEYFRAME_STALE_MS=4000
SIP_VIDEO_KEYFRAME_FIR_STALE_MS=8000
SIP_VIDEO_RECOVERY_BURST_ENABLED=true
SIP_VIDEO_RECOVERY_BURST_WINDOW_MS=8000
SIP_VIDEO_RECOVERY_BURST_INTERVAL_MS=1000
SIP_VIDEO_RECOVERY_BURST_STALE_MS=4000
SIP_VIDEO_RECOVERY_BURST_FIR_STALE_MS=7000

# Continuous SIP video RTP disorder monitor. Containment is opt-in.
SIP_VIDEO_RTP_DISORDER_MONITOR_ENABLED=true
SIP_VIDEO_RTP_DISORDER_MIN_PACKET_DELTA=300
SIP_VIDEO_RTP_DISORDER_MAX_GAP_DELTA=45
SIP_VIDEO_RTP_DISORDER_MAX_MISSING_DELTA=80
SIP_VIDEO_RTP_DISORDER_MAX_OOO_DELTA=80
SIP_VIDEO_RTP_DISORDER_MAX_REORDER_TIMEOUT_DELTA=20
SIP_VIDEO_RTP_DISORDER_CONSECUTIVE_WINDOWS=3
SIP_VIDEO_RTP_DISORDER_LOG_INTERVAL_MS=5000
SIP_VIDEO_RTP_DISORDER_CONTAINMENT_ENABLED=false
SIP_VIDEO_RTP_DISORDER_CONTAINMENT_MS=10000

# @switch video transition hold (SIP -> WebRTC)
# blackout (default): drop SIP->WebRTC video until complete-IDR gate releases.
# preserve: rollback mode that keeps the last rendered frame visible while
# holding unsafe non-keyframe packets until first keyframe or max wait timeout.
SIP_SWITCH_VIDEO_TRANSITION_MODE=blackout
SIP_SWITCH_VIDEO_BLACKOUT_ENABLED=true
SIP_SWITCH_VIDEO_BLACKOUT_MS=300
SIP_SWITCH_VIDEO_BLACKOUT_MAX_WAIT_MS=1200
# Post-switch recovery and RTP stability thresholds.
SIP_SWITCH_VIDEO_RECOVERY_WINDOW_MS=5000
SIP_SWITCH_VIDEO_RECOVERY_STABLE_MS=750
SIP_SWITCH_VIDEO_RTP_STABILITY_ENABLED=true
SIP_SWITCH_VIDEO_RTP_MIN_PACKET_DELTA=30
SIP_SWITCH_VIDEO_RTP_MAX_GAP_DELTA=12
SIP_SWITCH_VIDEO_RTP_MAX_MISSING_DELTA=20
SIP_SWITCH_VIDEO_RTP_MAX_OOO_DELTA=20
SIP_SWITCH_VIDEO_RTP_MAX_REORDER_DROP_DELTA=0
SIP_SWITCH_VIDEO_RTP_MAX_REORDER_TIMEOUT_DELTA=5
# Ignore duplicate @switch messages for the same target within the debounce window.
SIP_SWITCH_DUPLICATE_DEBOUNCE_ENABLED=true
SIP_SWITCH_DUPLICATE_DEBOUNCE_MS=60000
# SIP re-INVITE/UPDATE support is enabled by default. The separate @switch
# client-assisted WebRTC renegotiation remains opt-in because it replaces the
# active PeerConnection offer/answer when the @switch MESSAGE is accepted,
# before the first post-switch IDR is forwarded to the client.
SIP_MIDCALL_RENEGOTIATION_ENABLE=true
SIP_SWITCH_VIDEO_RENEGOTIATE_ENABLE=false

# RTP Configuration (for media streams)
# UDP port range for RTP audio/video streams
# Default: 10500-10600 (supports ~25 concurrent video calls, ~100 audio-only calls)
RTP_PORT_MIN=10500
RTP_PORT_MAX=10600
# RTP packet buffer size in bytes (default: 16384 for Android mobile compatibility)
# Android WebRTC can send packets at higher rates. Increase if you experience blackscreen on Android
RTP_BUFFER_SIZE=16384

# Use RTP/AVPF profile for audio with RTCP feedback (default: false)
# When enabled, SDP audio m-line will use RTP/AVPF instead of RTP/AVP
# This enables RTCP feedback mechanisms for audio stream
# Requires SIP endpoint (Asterisk/Linphone) to support AVPF for audio
# For Asterisk chan_sip: may require avpf=yes in peer config (depending on version)
# Runtime default is false. Enable only after verifying SIP endpoint support.
SIP_AUDIO_USE_AVPF=false

# Inbound audio gain (SIP → WebRTC): decode Opus, apply PCM gain, re-encode Opus
# Requires Docker build with CGO + libopus (see Dockerfile)
# SIP_AUDIO_INBOUND_GAIN_ENABLE=false
# SIP_AUDIO_INBOUND_GAIN=1.5
# SIP_AUDIO_INBOUND_GAIN_MAX=3.0

# Use RTP/AVPF profile for video with RTCP feedback (PLI/FIR/NACK) (default: true)
# When enabled, SDP video m-line will use RTP/AVPF instead of RTP/AVP and include a=rtcp-fb attributes
# This enables Picture Loss Indication (PLI), Full Intra Request (FIR), and Negative Acknowledgments (NACK)
# Requires SIP endpoint (Asterisk/Linphone) to support AVPF and RTCP feedback
# Advertises a=rtcp-fb:* ccm fir / nack / nack pli. chan_sip peers that answer RTP/AVP
# ignore the extra lines; PJSIP/Linphone use them to honor FIR+PLI. Keep
# SIP_VIDEO_FEEDBACK_TRANSPORT=dual so chan_sip still receives feedback on the RTP port.
# Set to true if your SIP server and clients support AVPF for better keyframe recovery
SIP_VIDEO_USE_AVPF=true

# SIP-side transport target for outbound video feedback packets (PLI/FIR/NACK)
# Values: auto | rtp | rtcp | dual
# - dual: always send both RTP and RTCP (RTP first). Required for Asterisk chan_sip.
# - auto: same RTP+RTCP pair as dual; the fallback window may also add rtp+1
# - rtp:  always send feedback to SIP video RTP port (rtcp-mux style)
# - rtcp: always send feedback to learned/rtp+1 RTCP target only
SIP_VIDEO_FEEDBACK_TRANSPORT=dual

# Assemble SIP H.264 RTP into complete access units before WebRTC forwarding.
# Keeps outbound sequence/timestamps continuous and drops incomplete FU-A frames.
# Set false only as a temporary rollback to the legacy raw reordered path.
SIP_VIDEO_AU_NORMALIZE_ENABLE=true
# Preserve H.264 STAP-A packets instead of expanding them (default: false).
SIP_VIDEO_PRESERVE_STAPA=false

# Database (required for trunk resolve/create)
DB_ENABLE=true
# Example Postgres DSN: postgres://user:pass@host:5432/dbname?sslmode=disable
DB_DSN=postgres://gateway_user:replace_from_secret_store@localhost:5432/webrtc_sip_gateway?sslmode=disable
# Run bootstrap before gateway startup only for local or single-instance use.
# Production compose profiles run a one-shot db-bootstrap job instead.
DB_BOOTSTRAP_ON_START=false
# Duration values accepted by Go, for example 30s or 5m.
DB_BOOTSTRAP_LOCK_TIMEOUT=30s
DB_BOOTSTRAP_MIGRATION_TIMEOUT=5m
# Bounded asynchronous persistence and retention defaults.
DB_STATS_INTERVAL_MS=5000
DB_BATCH_SIZE=100
DB_BATCH_INTERVAL_MS=1000
DB_PARTITION_LOOKAHEAD_DAYS=7
DB_RETENTION_PAYLOADS_DAYS=730
DB_RETENTION_EVENTS_DAYS=730
DB_RETENTION_STATS_DAYS=730
DB_RETENTION_SESSIONS_DAYS=730

# Public per-call SIP account registry.
SIP_PUBLIC_REGISTER_EXPIRES_SECONDS=3600
SIP_PUBLIC_REGISTER_TIMEOUT_SECONDS=10
SIP_PUBLIC_IDLE_TTL_SECONDS=600
SIP_PUBLIC_CLEANUP_INTERVAL_SECONDS=30
SIP_PUBLIC_MAX_ACCOUNTS=1000

# SIP Trunk (auto-register from DB)
SIP_TRUNK_ENABLE=true
SIP_TRUNK_LEASE_TTL_SECONDS=60
SIP_TRUNK_LEASE_RENEW_INTERVAL_SECONDS=20
SIP_TRUNK_REGISTER_TIMEOUT_SECONDS=10

# Gateway identity / discovery
GATEWAY_INSTANCE_ID=dev-instance-1
# Public WS URL for redirect (e.g. wss://gateway.example.com/ws)
GATEWAY_PUBLIC_WS_URL=

# Cross-instance session-directory retention and cleanup.
SESSION_DIRECTORY_TTL_SECONDS=7200
SESSION_DIRECTORY_CLEANUP_INTERVAL_SECONDS=300

# Push Notification (FCM fallback via TTRS + APNs PushKit for iOS VoIP)
# When PUSH_ENABLE=true, gateway sends configured push channels on incoming trunk calls.
# FCM requires TTRS Notification API credentials and Firebase service account.
# APNs uses the iOS PushKit token persisted in sip_trunks.pn_token.
PUSH_ENABLE=false
# SIP Contact app-id accepted for trunk PushKit tokens.
PUSH_TRUNK_PN_APP_ID=th.or.ttrs.video.prod
# TTRS Notification API base URL
PUSH_TTRS_API_URL=https://api.ttrs.or.th
# HTTP timeout for TTRS API calls (milliseconds)
PUSH_TTRS_API_TIMEOUT_MS=5000
# Extremely sensitive troubleshooting switch: logs the OAuth bearer token and
# request URL locally. Never enable in production or centralize these records.
PUSH_DEBUG_TTRS_TOKEN=false

# Employee credentials used for /employees/v3/accounts/:id/notifications
AUTH_TTRS_EMPLOYEE_TOKEN_URL=https://accounts.ttrs.or.th/auth/realms/TTRS-Employees/protocol/openid-connect/token
AUTH_TTRS_EMPLOYEE_TOKEN_GRANT_TYPE=client_credentials
AUTH_TTRS_EMPLOYEE_CLIENT_ID=TTRS_Develop
AUTH_TTRS_EMPLOYEE_CLIENT_SECRET=replace_from_secret_store

PUSH_FIREBASE_CREDENTIALS_FILE=
PUSH_FIREBASE_PROJECT_ID=643558767688

# APNs VoIP / PushKit
PUSH_APNS_ENABLE=false
# sandbox or production
PUSH_APNS_ENV=production
# token (default, .p8 key) or certificate (PEM client certificate)
PUSH_APNS_AUTH_MODE=token

# Token auth (.p8)
PUSH_APNS_KEY_FILE=
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=

# Certificate auth (PEM). Cert/key may be separate files, or one combined PEM.
# When PUSH_APNS_CERT_KEY_FILE is empty, gateway uses PUSH_APNS_CERT_FILE for both cert and key.
PUSH_APNS_CERT_FILE=
PUSH_APNS_CERT_KEY_FILE=

PUSH_APNS_BUNDLE_ID=th.or.nectec.kasemsan.softphone
# Defaults to <PUSH_APNS_BUNDLE_ID>.voip when empty
# For certificate auth, set this explicitly to a topic contained in the certificate,
# for example th.or.nectec.kasemsan.softphone.voip.
PUSH_APNS_TOPIC=

# Optional speech translation service.
TRANSLATOR_ENABLE=false
TRANSLATOR_ADDR=localhost:5000
TRANSLATOR_SOURCE_LANG=en-US
TRANSLATOR_TARGET_LANG=th
TRANSLATOR_TTS_VOICE=th-TH-PremwadeeNeural
TRANSLATOR_OPUS_BITRATE=24000
