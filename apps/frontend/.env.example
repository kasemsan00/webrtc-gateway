VITE_GATEWAY_URL=gateway.example.com
# Production single-domain deploy uses /admin/ (see deploy/README.md).
# Leave unset for local `pnpm dev` (serves at /).
# VITE_BASE_PATH=/admin/
VITE_CONFIG_AUTORECORD=1

# Shared admin password for the frontend login and gateway REST bearer.
# Required in the frontend process and the gateway process. Never use VITE_.
FRONTEND_PASSWORD=changeme
